DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5432/ai_project_monitoring

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

APP_ENV=development
STUDENT_EMAIL_DOMAINS=university.edu
FACULTY_EMAIL_ALLOWLIST=faculty@university.edu
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
OTP_HMAC_SECRET=replace-with-another-unique-random-secret-at-least-32-bytes
AUTH_TOKEN_ISSUER=ai-project-monitoring
AUTH_TOKEN_AUDIENCE=ai-project-monitoring-api
AUTH_TOKEN_LIFETIME_MINUTES=30
AUTH_OTP_LIFETIME_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_SENDS_PER_HOUR=5
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_RATE_LIMIT_AUTH_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_RESEND_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_LOGIN_EMAIL_MAX=10
AUTH_RATE_LIMIT_LOGIN_IP_MAX=60
AUTH_RATE_LIMIT_REGISTRATION_EMAIL_MAX=3
AUTH_RATE_LIMIT_REGISTRATION_IP_MAX=10
AUTH_RATE_LIMIT_VERIFY_EMAIL_MAX=10
AUTH_RATE_LIMIT_VERIFY_IP_MAX=60
AUTH_RATE_LIMIT_RESEND_EMAIL_MAX=5
AUTH_RATE_LIMIT_RESEND_IP_MAX=20
# Authentication buckets are shared through PostgreSQL; do not replace with
# process-local limits in a multi-worker deployment.
